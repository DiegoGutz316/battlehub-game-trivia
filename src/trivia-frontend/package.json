{
  "name": "trivia-frontend",
  "description": "Microfrontend de Trivia Battle (BattleHub - Equipo 5).",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoGutz316/battlehub-game-trivia.git"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "aurelia": "2.0.0-rc.2",
    "@aurelia/router": "2.0.0-rc.2"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "@aurelia/testing": "2.0.0-rc.2",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0",
    "html-webpack-plugin": "^5.6.3",
    "webpack-bundle-analyzer": "^4.10.2",
    "style-loader": "^4.0.0",
    "css-loader": "^7.1.2",
    "dotenv-webpack": "^8.1.0",
    "terser-webpack-plugin": "^5.6.1",
    "@aurelia/webpack-loader": "2.0.0-rc.2",
    "ts-loader": "^9.5.1",
    "postcss-loader": "^8.1.1",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "tslib": "^2.8.1",
    "typescript-eslint": "^8.18.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "@types/jest": "^29.5.14",
    "@aurelia/ts-jest": "2.0.0-rc.2"
  },
  "scripts": {
    "lint:js": "cd ../.. && eslint --config src/trivia-frontend/eslint.config.mjs \"src/trivia-frontend/src/**/*.{js,ts}\" \"tests/trivia-frontend/**/*.ts\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css",
    "start": "webpack serve",
    "build": "webpack --env production",
    "analyze": "webpack --env production --analyze",
    "test": "jest"
  },
  "jest": {
    "roots": [
      "<rootDir>/src",
      "<rootDir>/../../tests/trivia-frontend"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ],
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/../../tests/trivia-frontend/setup.ts"
    ],
    "transform": {
      "\\.(css|sass|scss|styl|jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "jest-transform-stub",
      "\\.(ts|html)$": "@aurelia/ts-jest"
    },
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
