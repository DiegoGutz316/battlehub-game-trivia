# Variables para Docker Compose y ejecución local en contenedores.
# Copiar como ".env" (ignorado por git) y completar SOLO en tu máquina.
# Nunca subir valores reales al repositorio.
#
# Las claves de appsettings.json se escriben con "__" en lugar de ":".

# --- SQL Server (servicio "sqlserver" de docker-compose) ---
ACCEPT_EULA=Y
# Contraseña del usuario sa. Debe cumplir la política de SQL Server (mayúscula, minúscula, número, símbolo).
MSSQL_SA_PASSWORD=Change_Me_Strong_Passw0rd!

# Cadena de conexión usada por db-migrate, db-seed y la API DENTRO de la red Docker.
# El host es el nombre del servicio Compose ("sqlserver"), no localhost.
# La contraseña debe coincidir con MSSQL_SA_PASSWORD.
ConnectionStrings__Trivia=Server=sqlserver,1433;Database=BattleHubTrivia;User Id=sa;Password=Change_Me_Strong_Passw0rd!;TrustServerCertificate=True;Encrypt=False

# URL de la API que el navegador usará (se incrusta en el bundle del frontend al construir la imagen).
# Desde el anfitrión la API se publica en el puerto 5185.
TRIVIA_API_URL=http://localhost:5185

# Secreto del cliente de servicio de Trivia (aviso de fin de partida a Matchmaking). SENSIBLE.
Matchmaking__ClientSecret=

# Valores públicos opcionales (descomentar solo si hay que reemplazar appsettings.json):
# Auth__Issuer=https://dev-jaii1peslxnejq0y.us.auth0.com/
# Auth__Audience=https://api.battlehub.local/profile
# Matchmaking__BaseUrl=http://host.docker.internal:5211
# Matchmaking__TokenEndpoint=https://dev-jaii1peslxnejq0y.us.auth0.com/oauth/token
# Matchmaking__Audience=https://api.battlehub.local/profile
# Matchmaking__ClientId=xYhNYG9lOGLA6KvEM0Y4cccH2f7JDD5x
# Profile__BaseUrl=http://host.docker.internal:5220
# Cors__Origins__0=http://localhost:4000
# Cors__Origins__1=http://localhost:4002
