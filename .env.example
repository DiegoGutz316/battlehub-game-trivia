# Variables de configuración de la API de Trivia, para Docker o un despliegue.
# Copiar como ".env" (ignorado por git) y completar SOLO en tu máquina o en el servidor.
# Nunca subir valores reales al repositorio.
#
# Las claves de appsettings.json se escriben con "__" en lugar de ":".
# En local (dotnet run) los valores sensibles van en user-secrets; ver README, sección "Configuración y secretos".

# Clave pública RSA (SubjectPublicKeyInfo en Base64) con la que la API valida los tokens. OBLIGATORIA: sin ella la API no arranca.
# Es la clave pública, no un secreto.
Auth__PublicKey=

# Cadena de conexión a SQL Server. SENSIBLE si incluye usuario y contraseña.
ConnectionStrings__Trivia=

# Token de servicio para avisar el fin de partida a Matchmaking. SENSIBLE.
Matchmaking__ServiceToken=

# Valores públicos que cambian según el ambiente. Descomentar solo si hay que reemplazar los de appsettings.json:
# una variable vacía también reemplaza el valor de appsettings.json.
# Matchmaking__BaseUrl=http://localhost:5211
# Cors__Origins__0=http://localhost:4000
# Cors__Origins__1=http://localhost:4002
# Database__MigrateOnStartup=true
# Database__SeedQuestions=true
